{
  "name": "portfolio-rag-3dprint-chat-v1",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "none",
        "initialMessages": "Hi! I'm the LayerLab 3D assistant.\nAsk me about materials, design rules, pricing or delivery.\nTip: start a message with /claude, /deepseek or /gemini to switch AI model.",
        "options": {
          "title": "LayerLab 3D - Printing Assistant",
          "subtitle": "RAG chatbot demo by 03 Flow Forge",
          "inputPlaceholder": "e.g. Which material for an outdoor bracket?",
          "responseMode": "lastNode"
        }
      },
      "id": "68dd22f6-6c46-43de-bb56-a11201e6b41c",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Choose the AI provider for this message.\n// Default below; a customer (or you, in a demo) can switch per message with /claude, /deepseek or /gemini.\nconst DEFAULT_PROVIDER = 'deepseek';\nconst NAMES = { claude: 'Claude (Anthropic)', deepseek: 'DeepSeek', gemini: 'Gemini (Google)' };\nconst j = $input.first().json;\nlet text = String(j.chatInput || '').trim();\nlet provider = DEFAULT_PROVIDER;\nconst m = text.match(/^\\/(claude|deepseek|gemini)\\b\\s*/i);\nif (m) { provider = m[1].toLowerCase(); text = text.slice(m[0].length) || 'Hello'; }\nreturn [{ json: { sessionId: j.sessionId, chatInput: text, provider, provider_name: NAMES[provider] } }];"
      },
      "id": "9f0544d8-48a5-4dfa-a220-e362e9b5e4f2",
      "name": "Pick AI Provider",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are the virtual assistant of LayerLab 3D, an online 3D printing service.\nRules:\n1. Before answering any question about materials, design rules, specifications, file formats, pricing, delivery, finishing or policies, search the knowledge base tool. Use only facts found there.\n2. If the knowledge base does not contain the answer, say you do not know and offer to connect the customer with a human at support@layerlab3d.example. Never invent prices, dates, sizes or material properties.\n3. For price estimates, apply the pricing rules from the knowledge base step by step and show the calculation. Say the final price is confirmed after the file is uploaded.\n4. End every factual answer with a line \"Sources:\" listing the document and section names you used, for example (Materials > PETG).\n5. Reply in the customer's language (Vietnamese or English). Keep answers under about 120 words unless the customer asks for more detail.\n6. Politely refuse requests to print weapons or firearm parts.",
          "maxIterations": 6
        }
      },
      "id": "eae27237-d82c-4663-b713-51d3e7c5743a",
      "name": "3D Printing Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Show which AI model answered (useful when comparing providers).\nconst out = $input.first().json.output || '';\nreturn [{ json: { output: out + '\\n\\n_Answered by ' + $('Pick AI Provider').first().json.provider_name + '_' } }];"
      },
      "id": "da35f55f-3575-459a-8ebf-cb60a509ebed",
