  "nodes": [
    {
      "parameters": {},
      "id": "7fa52355-6f0a-4202-9ef7-f4a8ee421ec6",
      "name": "On Any Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "notes": "Set this workflow as the Error Workflow in each workflow's settings.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Turn n8n's error payload into a short, readable alert.\nconst e = $input.first().json;\nconst wf = e.workflow?.name || 'Unknown workflow';\nconst node = e.execution?.lastNodeExecuted || e.trigger?.error?.node?.name || 'unknown node';\nconst msg = String(e.execution?.error?.message || e.trigger?.error?.message || 'No error message').slice(0, 300);\nconst url = e.execution?.url || '';\nconst at = DateTime.now().setZone('Asia/Ho_Chi_Minh').toFormat('dd LLL yyyy, HH:mm');\nreturn [{ json: {\n  workflow: wf, node, message: msg, execution_url: url, happened_at: at,\n  alert: `WORKFLOW FAILED\\n${wf}\\nStep: ${node}\\nError: ${msg}\\nTime: ${at}${url ? '\\nOpen: ' + url : ''}`,\n} }];"
      },
      "id": "c56787cf-dd90-4ed8-9f6e-8f92241e77c4",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "",
        "text": "={{ (String(($json.alert) ?? '')).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
