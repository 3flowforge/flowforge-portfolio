      "id": "c04d43c6-ac77-4072-b8f1-e2e841d2edc4",
      "name": "Load Sites",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        100
      ],
      "notes": "Add or remove websites in the monitored_sites table, no code changes needed.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Check every active site: HTTP status, response time, optional keyword.\n// A site is only reported DOWN after CONFIRM_FAILS failed checks in a row (avoids false alarms).\nconst CONFIRM_FAILS = $execution.mode === 'production' ? 2 : 1;\nconst TIMEOUT_MS = 15000;\nconst now = DateTime.now().setZone('Asia/Ho_Chi_Minh');\nconst sites = $input.all().map(i => i.json).filter(s => s.url && s.active !== false);\nconst out = [];\nfor (const s of sites) {\n  const t0 = Date.now();\n  let code = null, ok = false, error = null;\n  try {\n    const r = await this.helpers.httpRequest({ url: s.url, method: 'GET', returnFullResponse: true, ignoreHttpStatusErrors: true, timeout: TIMEOUT_MS, headers: { 'User-Agent': '03FlowForge-Monitor/1.0' } });\n    code = r.statusCode;\n    ok = code >= 200 && code < 400;\n    if (ok && s.keyword) {\n      const body = Buffer.isBuffer(r.body) ? r.body.toString('utf8') : (typeof r.body === 'string' ? r.body : JSON.stringify(r.body));\n      if (!body.includes(s.keyword)) { ok = false; error = 'Keyword \"' + s.keyword + '\" not found on page'; }\n    }\n    if (!ok && !error) error = 'HTTP ' + code;\n  } catch (e) {\n    error = String(e.message || e).slice(0, 200);\n  }\n  const ms = Date.now() - t0;\n  const prev = s.status || 'unknown';\n  const fails = ok ? 0 : (s.fail_count || 0) + 1;\n  let status = prev;\n  let alert = null;\n  if (ok) {\n    if (prev === 'down') {\n      const mins = s.down_since ? Math.max(1, Math.round(now.diff(DateTime.fromISO(s.down_since), 'minutes').minutes)) : null;\n      alert = 'RECOVERED: ' + s.name + ' (' + s.url + ') is back up' + (mins ? ' after ' + mins + ' min' : '') + ', ' + ms + ' ms';\n    }\n    status = 'up';\n  } else if (fails >= CONFIRM_FAILS) {\n    if (prev !== 'down') alert = 'DOWN: ' + s.name + ' (' + s.url + ')\\nReason: ' + error + (s.client ? '\\nClient: ' + s.client : '');\n    status = 'down';\n  }\n  out.push({ json: {\n    id: s.id, name: s.name, url: s.url, client: s.client,\n    status, fail_count: fails, last_status_code: code, response_ms: ms, last_error: ok ? '' : error,\n    last_checked: now.toISO(),\n    down_since: status === 'down' ? (prev === 'down' && s.down_since ? s.down_since : now.toISO()) : '',\n    alert,\n  } });\n}\nreturn out;"
      },
