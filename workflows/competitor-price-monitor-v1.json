      "id": "ab755123-0619-4154-abc8-52bf770f32bf",
      "name": "Save Prices",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// One Telegram message listing only what changed.\nconst rows = $('Compare').all().map(i => i.json);\nconst changed = rows.filter(r => r.status === 'price_changed' || r.status === 'stock_changed');\nif (!changed.length) return [];\nconst fmt = n => '£' + n.toFixed(2);\nconst lines = changed.map(r => r.status === 'price_changed'\n  ? `- ${r.product}: ${fmt(r.prev_price)} -> ${fmt(r.price)} (${r.change > 0 ? '+' : ''}${r.change_pct}%)`\n  : `- ${r.product}: now ${r.in_stock ? 'back in stock' : 'OUT OF STOCK'}`);\nconst drops = changed.filter(r => r.change < 0).length;\nreturn [{ json: { changes: changed.length, alert: `COMPETITOR PRICE WATCH\\n${changed.length} change(s) across ${rows.length} tracked products${drops ? ' - ' + drops + ' price drop(s), consider matching' : ''}:\\n${lines.join('\\n')}` } }];"
      },
