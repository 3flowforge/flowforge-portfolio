      "id": "b4d89738-3357-4230-a0d0-1e83b66415e4",
      "name": "Fetch Competitor Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "notes": "Demo target: books.toscrape.com (a site built for scraping practice). Swap for the client's competitor URLs.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Pull product name, price and stock from the category page.\nconst BASE = 'https://books.toscrape.com/catalogue/';\nconst decode = s => s.replace(/&#39;/g, \"'\").replace(/&quot;/g, '\"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');\nconst html = String($input.first().json.data || '');\nconst cards = html.split('<article class=\"product_pod\">').slice(1);\nconst out = [];\nfor (const c of cards) {\n  const a = c.match(/<h3><a href=\"([^\"]+)\" title=\"([^\"]+)\"/);\n  const p = c.match(/class=\"price_color\">[^0-9]*([0-9.]+)</);\n  if (!a || !p) continue;\n  out.push({ json: {\n    product: decode(a[2]),\n    url: BASE + a[1].replace(/^(\\.\\.\\/)+/, ''),\n    price: Number(p[1]),\n    in_stock: /In stock/i.test(c),\n  } });\n}\nif (!out.length) throw new Error('No products found - the page layout may have changed');\nreturn out;"
      },
      "id": "d87d0a66-c9d0-4d1f-8519-98bc2c0b4ddd",
      "name": "Parse Products",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "ENeYoQTefXd4dfAF",
          "mode": "list",
          "cachedResultName": "competitor_prices",
          "cachedResultUrl": "/projects/gY8Fh8Cme18zq6oq/datatables/ENeYoQTefXd4dfAF"
        },
        "returnAll": true
      },
      "id": "b26dfa9c-cba0-4afc-a423-e5c932d129a6",
      "name": "Load Last Prices",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        100
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Compare today's prices with the last saved ones.\nconst last = new Map($('Load Last Prices').all().map(i => i.json).filter(r => r.product).map(r => [r.product, r]));\nconst now = DateTime.now().setZone('Asia/Ho_Chi_Minh').toFormat('yyyy-LL-dd HH:mm');\nreturn $('Parse Products').all().map(({ json: p }) => {\n  const prev = last.get(p.product);\n  const change = prev ? Math.round((p.price - prev.price) * 100) / 100 : null;\n  let status = 'new';\n  if (prev) status = change !== 0 ? 'price_changed' : (prev.in_stock !== p.in_stock ? 'stock_changed' : 'same');\n  return { json: { ...p, prev_price: prev ? prev.price : null, change, change_pct: prev && prev.price ? Math.round(change / prev.price * 1000) / 10 : null, status, last_checked: now } };\n});"
      },
      "id": "662e981b-aad5-453b-99b8-3930456fb314",
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
