    {
      "parameters": {
        "jsCode": "// Pick bookings that start within the reminder window and have not been reminded yet.\n// Production (schedule): 24h window. Manual test run: 48h so you can test today.\nconst WINDOW_HOURS = $execution.mode === 'production' ? 24 : 48;\nconst now = DateTime.now();\nreturn $input.all()\n  .map(i => i.json)\n  .filter(a => a.status === 'booked' && a.start_iso && !a.reminded)\n  .filter(a => {\n    const h = DateTime.fromISO(a.start_iso).diff(now, 'hours').hours;\n    return h > 0 && h <= WINDOW_HOURS;\n  })\n  .map(a => ({ json: { ...a, message: `Reminder for ${a.patient_name} (${a.phone}): ${a.service} at Smile Dental Clinic on ${a.start_label} (Central Time). Reply C to confirm or call us to reschedule.` } }));\n"
      },
      "id": "a62537ee-abf5-48e8-b355-4c32e73cc3bb",
      "name": "Due Within 24h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "",
        "text": "={{ (String(($json.message) ?? '')).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "5b606229-e449-4ee5-ad78-8fcdab204021",
